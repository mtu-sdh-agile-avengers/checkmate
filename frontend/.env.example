# Where the pages get their data:
#   live - our backend API; start it first: cd backend/app && uv run fastapi dev
#   mock - built-in demo data, no backend needed (used when this variable is not set)
VITE_API_MODE=live
# Backend API base URL; /api/v1 goes through the Vite dev proxy to http://localhost:8000
VITE_API_BASE_URL=/api/v1
